GROQ_API_KEY=your_groq_api_key_here
GROQ_REQUEST_TIMEOUT_SECONDS=60
GROQ_MAX_RETRY_ATTEMPTS=4
GROQ_RETRY_BASE_DELAY_SECONDS=2
GROQ_RETRY_MAX_DELAY_SECONDS=120

PLANNER_MODEL=openai/gpt-oss-20b
CODE_WRITER_MODEL=openai/gpt-oss-20b
CODE_UPDATER_MODEL=openai/gpt-oss-20b
RATER_MODEL=openai/gpt-oss-20b
CRITERIA_UPDATER_MODEL=openai/gpt-oss-20b

PLANNER_TEMPERATURE=0.2
PLANNER_MAX_COMPLETION_TOKENS=700
CODE_WRITER_TEMPERATURE=0.5
CODE_WRITER_MAX_COMPLETION_TOKENS=4000
CODE_UPDATER_TEMPERATURE=0.4
CODE_UPDATER_MAX_COMPLETION_TOKENS=4000
RATER_TEMPERATURE=0.1
RATER_MAX_COMPLETION_TOKENS=1000
CRITERIA_UPDATER_TEMPERATURE=0.1
CRITERIA_UPDATER_MAX_COMPLETION_TOKENS=1000

# Application settings (React frontend + FastAPI backend)
LOOP_DATABASE_PATH=data/loop.sqlite3
LOOP_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:8000,http://localhost:8000
LOOP_ENABLE_DEMO=true
# Set true when serving over HTTPS in production.
LOOP_SECURE_COOKIES=false
