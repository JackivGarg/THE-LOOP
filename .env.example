CODE_WRITER_MAX_COMPLETION_TOKENS=5000
CODE_UPDATER_TEMPERATURE=0.5
CODE_UPDATER_MAX_COMPLETION_TOKENS=5000
RATER_TEMPERATURE=0.1
RATER_MAX_COMPLETION_TOKENS=512
CRITERIA_UPDATER_TEMPERATURE=0.1
